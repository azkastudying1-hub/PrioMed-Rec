{
  "mcpServers": {
    "priomedrec-api": {
      "command": "uvicorn",
      "args": ["api.main:app", "--host", "0.0.0.0", "--port", "8000"],
      "env": {
        "PRIOMEDREC_API_URL": "http://localhost:8000",
        "LANGFLOW_URL": "http://localhost:7860",
        "LLM_PROVIDER": "${LLM_PROVIDER}",
        "LLM_API_KEY": "${LLM_API_KEY}",
        "LLM_MODEL_NAME": "${LLM_MODEL_NAME}",
        "LLM_BASE_URL": "${LLM_BASE_URL}"
      },
      "tools": [
        {
          "name": "get_patient_context",
          "description": "Retrieve admission context for a specific patient encounter from the processed data.",
          "input_schema": {
            "type": "object",
            "properties": {
              "patient_id":   { "type": "string", "description": "Patient identifier" },
              "encounter_id": { "type": "string", "description": "Encounter identifier" }
            },
            "required": ["patient_id", "encounter_id"]
          },
          "http": {
            "url": "${PRIOMEDREC_API_URL}/health",
            "method": "GET"
          }
        },
        {
          "name": "predict_patient_risk",
          "description": "Call the /prioritize endpoint to predict medication discrepancy risk for a patient encounter. Returns risk_probability, priority, and top contributing features. Bob must call this tool — never compute risk directly.",
          "input_schema": {
            "type": "object",
            "properties": {
              "age":                            { "type": "number", "minimum": 0 },
              "age_65_plus":                    { "type": "integer", "enum": [0, 1] },
              "gender_encoded":                 { "type": "integer", "enum": [0, 1] },
              "pre_admission_medication_count": { "type": "integer", "minimum": 0 },
              "admission_medication_count":     { "type": "integer", "minimum": 0 },
              "total_medication_count":         { "type": "integer", "minimum": 0 },
              "new_medication_count":           { "type": "integer", "minimum": 0 },
              "discontinued_medication_count":  { "type": "integer", "minimum": 0 },
              "polypharmacy_flag":              { "type": "integer", "enum": [0, 1] },
              "high_alert_flag":                { "type": "integer", "enum": [0, 1] },
              "high_alert_count":               { "type": "integer", "minimum": 0 },
              "potential_duplicate_candidates": { "type": "integer", "minimum": 0 },
              "active_condition_count":         { "type": "integer", "minimum": 0 },
              "prior_encounter_count":          { "type": "integer", "minimum": 0 },
              "allergy_count":                  { "type": "integer", "minimum": 0 },
              "has_drug_allergy":               { "type": "integer", "enum": [0, 1] }
            },
            "required": ["age", "total_medication_count"]
          },
          "http": {
            "url": "${PRIOMEDREC_API_URL}/prioritize",
            "method": "POST"
          }
        },
        {
          "name": "detect_discrepancies",
          "description": "Call the /discrepancies endpoint to detect potential medication discrepancies using the rule engine. Returns list of flags with verification_required=true.",
          "input_schema": {
            "type": "object",
            "properties": {
              "patient_id":          { "type": "string" },
              "encounter_id":        { "type": "string" },
              "pre_admission_meds":  { "type": "array", "items": { "type": "object" } },
              "admission_meds":      { "type": "array", "items": { "type": "object" } }
            },
            "required": ["patient_id", "encounter_id"]
          },
          "http": {
            "url": "${PRIOMEDREC_API_URL}/discrepancies",
            "method": "POST"
          }
        },
        {
          "name": "get_explanation",
          "description": "Request a natural-language explanation of the prioritization and discrepancy results via the LLM service (Langflow). Bob must not generate clinical explanations directly.",
          "input_schema": {
            "type": "object",
            "properties": {
              "patient_context":     { "type": "object", "description": "Patient + risk + discrepancy context" },
              "task":                { "type": "string", "enum": ["PATIENT_SUMMARY", "RISK_EXPLANATION", "DISCREPANCY_QUERY", "PHARMACIST_QA"] },
              "question":            { "type": "string", "description": "Pharmacist question (for PHARMACIST_QA only)" }
            },
            "required": ["patient_context", "task"]
          },
          "http": {
            "url": "${LANGFLOW_URL}/api/v1/run/priomedrec-orchestrator-v1",
            "method": "POST"
          }
        },
        {
          "name": "rank_patients",
          "description": "Sort a list of encounter results by risk_probability descending. Returns ranked list for pharmacist prioritization.",
          "input_schema": {
            "type": "object",
            "properties": {
              "encounters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "encounter_id":    { "type": "string" },
                    "risk_probability": { "type": "number" },
                    "priority":        { "type": "string" }
                  }
                }
              }
            },
            "required": ["encounters"]
          }
        }
      ]
    }
  }
}
