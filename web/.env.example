# web/.env.local — Konfigurasi frontend lokal
# Salin ke web/.env.local dan sesuaikan

# Mode data: "synthetic" (mock) atau "live" (FastAPI)
# Gunakan "synthetic" untuk dev tanpa backend
# Gunakan "live" untuk mode demo lengkap dengan JWT auth
VITE_DATA_MODE=live

# API key legacy (untuk backward compat — tidak diperlukan jika VITE_DATA_MODE=live dan JWT aktif)
VITE_API_KEY=

# Langflow (TIDAK digunakan langsung browser — routing via FastAPI AI Gateway)
# Variabel ini dipertahankan untuk konfigurasi backend, bukan untuk panggilan browser langsung
VITE_LANGFLOW_URL=
VITE_LANGFLOW_ORCHESTRATOR_FLOW_ID=
VITE_LANGFLOW_REVIEW_FLOW_ID=
VITE_LANGFLOW_API_KEY=
