# Simple .env for local development
LLM_PROVIDER=gemini
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8001
LLM_API_KEY=AIzaSyDummyKeyForTesting1234567890

# JWT Authentication
JWT_SECRET_KEY=test_secret_key_for_development_only_123
JWT_REFRESH_SECRET_KEY=test_refresh_key_for_development_only_456
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# Database
DATABASE_URL=sqlite:///data/priomed.db
DB_PATH=data/priomed.db

# Service API Keys
SERVICE_API_KEY_LANGFLOW=test_langflow_key_123
SERVICE_API_KEY_MCP=test_mcp_key_456

# FastAPI Configuration
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8001

# Disable Langflow for now (use direct mode)
EXECUTION_MODE=direct_only

# For MCP server
PRIOMEDREC_API_URL=http://127.0.0.1:8001