# =============================================================================
# PrioMed-Rec Environment Configuration
# =============================================================================
# Salin file ini: cp .env.example .env
# Isi nilai yang sesuai di .env — JANGAN commit .env ke git
# =============================================================================

# ---------------------------------------------------------------------------
# LLM Provider — Google AI Studio (Gemini)
# ---------------------------------------------------------------------------
# Dapatkan API key gratis di: https://aistudio.google.com/app/apikey
# Klik "Create API Key" → copy → paste di bawah

LLM_PROVIDER=gemini
## Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost
LLM_API_KEY=your-gemini-api-key-here
LLM_MODEL_NAME=gemini-2.5-flash
LLM_BASE_URL=
GOOGLE_API_KEY=
LLM_GROQ_API_KEY=
OLLAMA_BASE_URL=
# Optional aliases for Langflow's Google Generative AI node.
# GOOGLE_API_KEY=${LLM_API_KEY}
# LLM_GROQ_API_KEY=
# LLM_GROQ_MODEL=llama-3.3-70b-versatile
# OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Provider Alternatif (uncomment salah satu jika tidak pakai Gemini)
# ---------------------------------------------------------------------------

# --- Groq (gratis, sangat cepat) ---
# Daftar di: https://console.groq.com
# LLM_PROVIDER=groq
# LLM_API_KEY=your-groq-api-key-here
# LLM_MODEL_NAME=mixtral-8x7b-32768
# LLM_BASE_URL=https://api.groq.com/openai/v1

# --- OpenAI ---
# LLM_PROVIDER=openai
# LLM_API_KEY=your-openai-api-key-here
# LLM_MODEL_NAME=gpt-4o-mini
# LLM_BASE_URL=

# --- Mistral ---
# LLM_PROVIDER=mistral
# LLM_API_KEY=your-mistral-api-key-here
# LLM_MODEL_NAME=mistral-small-latest
# LLM_BASE_URL=https://api.mistral.ai/v1

# ---------------------------------------------------------------------------
# JWT Authentication (B-103)
# ---------------------------------------------------------------------------
# Ganti dengan string acak ≥ 32 karakter di production!
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_in_production_min_32chars!!
JWT_REFRESH_SECRET_KEY=CHANGE_ME_refresh_in_production!!
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# Database (B-101)
# ---------------------------------------------------------------------------
# SQLite untuk demo (ubah ke postgresql://user:pass@host/db untuk produksi)
DATABASE_URL=sqlite:///data/priomed.db
DB_PATH=data/priomed.db

# ---------------------------------------------------------------------------
# Service API Keys (untuk Langflow & MCP — bukan untuk pengguna manusia)
# ---------------------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_API_KEY_LANGFLOW=changeme-langflow-service-key
SERVICE_API_KEY_MCP=changeme-mcp-service-key

# ---------------------------------------------------------------------------
# FastAPI Configuration
# ---------------------------------------------------------------------------
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# ---------------------------------------------------------------------------
# Langflow Orchestration
# ---------------------------------------------------------------------------
# URL used only by FastAPI. Browser clients never call Langflow directly.
LANGFLOW_URL=http://langflow:7860
LANGFLOW_BASE_URL=http://langflow:7860
EXECUTION_MODE=langflow_first
LANGFLOW_TIMEOUT_SECONDS=25
LANGFLOW_CIRCUIT_FAILS=3
LANGFLOW_CIRCUIT_RESET_SECONDS=60

# Flow IDs — copy from Langflow UI after importing the flows:
#   Import langflow/priomedrec_orchestrator.json  → copy its Flow ID
#   Import langflow/priomedrec_review.json        → copy its Flow ID
LANGFLOW_MASTER_FLOW_ID=
LANGFLOW_MASTER_FLOW_HASH=
LANGFLOW_ORCHESTRATOR_FLOW_ID=ab69172c-78ec-45bd-85cd-83ddbcb6cc50
LANGFLOW_REVIEW_FLOW_ID=e903f5fc-3a3e-4cd3-9773-dca76018f5a6

# Base URL FastAPI yang dipanggil oleh komponen Langflow (service-to-service).
PRIOMEDREC_API_URL=http://api:8000

# Langflow 1.12 requires explicit credentials; never use defaults in production.
LANGFLOW_SUPERUSER=langflow-admin
LANGFLOW_SUPERUSER_PASSWORD=CHANGE_ME_use_a_strong_unique_password
LANGFLOW_SECRET_KEY=CHANGE_ME_use_a_long_random_secret

# Langflow API key (optional — set if you enable auth on Langflow)
LANGFLOW_API_KEY=
